{
  "python.defaultInterpreterPath": "${workspaceFolder}/../../p3.13/bin/python",
  // ------------------------------
  // Code formatting
  // ------------------------------
  // Use Black as the Python code formatter (PEP 8 compliant, opinionated).
  // Install: pip install black
  // Manual command: black .
  "python.formatting.provider": "black",
  // Automatically run the formatter (Black) whenever you save a file.
  "editor.formatOnSave": true,
  // ------------------------------
  // Linting
  // ------------------------------
  // Enable linting in VS Code (static code checks).
  "python.linting.enabled": true,
  // Use Ruff as the linter (fast, replaces flake8, autopep8, isort).
  // Install: pip install ruff
  // Manual command: ruff check --fix .
  "python.linting.ruffEnabled": true,
  // Path to Ruff binary (if installed via pip, "ruff" works).
  "python.linting.ruffPath": [
    "ruff"
  ],
  // ------------------------------
  // Type checking
  // ------------------------------
  // Enable Mypy type checking (checks Python type hints).
  // Install: pip install mypy
  // Manual command: mypy .
  "python.linting.mypyEnabled": true,
  // ------------------------------
  // Docstrings
  // ------------------------------
  // Default docstring style for AutoDocstring extension.
  // Options: "google", "numpy", "sphinx".
  // Install extension: ms-python.autoDocstring
  // Manual trigger:
  //   - Win/Linux: Alt+Shift+A
  //   - macOS: Cmd+Shift+2
  //   - Or Command Palette: "Generate Docstring"
  "autoDocstring.docstringFormat": "google",
  // Docformatter formats existing docstrings (PEP 257).
  // Install: pip install docformatter
  // Manual command: docformatter --in-place --recursive .
  // (⚠ Not auto-run by VS Code, add via pre-commit for automation)
  // ------------------------------
  // Extra code actions on save
  // ------------------------------
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
    "source.fixAll": "explicit"
  }
}